# Normalize line endings: LF in repo, native on checkout
* text=auto

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.nsh text eol=crlf

# Source files use LF
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.svg text eol=lf

# Binary assets
*.png binary
*.ico binary
*.bmp binary
*.jpg binary

# Test fixtures are byte-exact captures
test/fixtures/** text eol=lf
